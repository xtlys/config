name: Local Domain DNS Direct Override
desc: Force photonchord.com and higgsasset.com to use system DNS and DIRECT, avoid fake-ip issues for xmake.io

dns:
  enable: true
  enhanced-mode: redir-host
  nameserver-policy:
    '+.photonchord.com': system
    '+.higgsasset.com': system
  fake-ip-filter:
    - 'xmake.io'
    - '+.xmake.io'
    - 'photonchord.com'
    - '+.photonchord.com'
    - 'higgsasset.com'
    - '+.higgsasset.com'

rules:
  - DOMAIN-SUFFIX,photonchord.com,DIRECT
  - DOMAIN-SUFFIX,higgsasset.com,DIRECT
  # Cloudflare DDNS IP Probe
  - DOMAIN-SUFFIX,icanhazip.com,DIRECT
  - DOMAIN-SUFFIX,ifconfig.me,DIRECT
  # Grok / xAI
  - DOMAIN-SUFFIX,grok.com,TAGSS
  - DOMAIN-SUFFIX,x.ai,TAGSS
  # X / Twitter login and embedded Grok dependencies, optional
  - DOMAIN-SUFFIX,x.com,TAGSS
  - DOMAIN-SUFFIX,twitter.com,TAGSS
  - DOMAIN-SUFFIX,twimg.com,TAGSS
  - DOMAIN-SUFFIX,t.co,TAGSS
  # Hugging Face
  - DOMAIN-SUFFIX,huggingface.co,TAGSS
  - DOMAIN-SUFFIX,hf.co,TAGSS
  - DOMAIN-SUFFIX,huggingfaceusercontent.com,TAGSS
